# Copy to backend/.env and add Google OAuth credentials if you want Google sign-in.
# Never commit backend/.env or share the client secret in chat.
DATABASE_PATH=/app/data/prepcompass.db
FRONTEND_URL=http://localhost:3011
BACKEND_URL=http://localhost:8011
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenAI — server-side only; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=
