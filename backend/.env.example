# PrepCompass local configuration. Copy to backend/.env; never commit real secrets.
DATABASE_PATH=/app/data/prepcompass.db
FRONTEND_URL=http://localhost:3011
BACKEND_URL=http://localhost:8011
COOKIE_SECURE=false

# Optional Google OAuth (unrelated to AI inference)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free-inference-only AI routing. No OpenAI billing or paid fallback is used.
# Primary provider: gemini, groq, or ollama
AI_PROVIDER=gemini
# Ordered fallbacks; remove providers you do not want to use.
AI_FALLBACK_PROVIDERS=groq,ollama

# Gemini Developer API: create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GroqCloud: create a developer key; free-tier limits apply.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama local model. On Docker Desktop for Mac, use host.docker.internal.
# Install Ollama on the Mac, pull a model, then set OLLAMA_MODEL to that exact name.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
